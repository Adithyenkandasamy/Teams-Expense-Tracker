# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/expense_tracker

# Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# App Config
DEFAULT_REMINDER_INTERVAL_HOURS=24
RECEIPT_RETENTION_DAYS=2

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# Environment
ENVIRONMENT=development
